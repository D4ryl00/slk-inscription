    "smoke:installment": "node scripts/smoke-installment.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "netlify-cli": "^17.0.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
