{
  "name": "slk-inscription",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site d'inscription des adhérents du Stade Laurentin Karaté (SLK) — paiement HelloAsso + registre Google Sheet",
  "scripts": {
    "dev": "netlify dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run test:e2e && npm run build",
    "drive:token": "node scripts/get-drive-refresh-token.mjs",
